# bitshuffle, for decompressing Eiger chunks in the spot finder.
#
# The spot finder arrived as a subtree merge carrying its own .gitmodules, which
# git could not see -- it reads the file at the repository root only -- and
# which would have left the submodule silently uninitialised. That file has been
# removed; if the subtree is ever split back out, it needs restoring.
[submodule "third_party/bitshuffle"]
	path = third_party/bitshuffle
	url = https://github.com/kiyo-masui/bitshuffle.git
